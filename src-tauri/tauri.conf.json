{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniAppHub",
  "version": "0.1.0",
  "identifier": "dev.miniapphub.desktop",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "npm run build:www"
  },
  "app": {
    "windows": [
      {
        "title": "MiniAppHub",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https:; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "MiniAppHub — платформа HTML5 мини-приложений",
    "publisher": "MiniAppHub"
  }
}
